# Copy to .env.local and fill in. Never commit real values.
# NEXT_PUBLIC_* values are bundled into the browser: public by design, never put a secret in one.

# Supabase URL (public: RLS is the boundary)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key (public: RLS is the boundary)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase secret key, acts as service_role and skips RLS (server only)
SUPABASE_SECRET_KEY=

# Clerk publishable key (public, client)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Clerk secret key (server only)
CLERK_SECRET_KEY=
# Clerk webhook signing secret (server only)
CLERK_WEBHOOK_SIGNING_SECRET=

# OpenAI API key (server only)
OPENAI_API_KEY=

# Arcjet key (server only)
ARCJET_KEY=

# PostHog project key (public, client + server)
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog host (public, client + server)
NEXT_PUBLIC_POSTHOG_HOST=

# Base URL of this app, e.g. http://localhost:3000 (public, client + server)
NEXT_PUBLIC_APP_URL=

# Widget public key for the landing page demo, per environment (server only, read at request time)
LANDING_WIDGET_KEY=
